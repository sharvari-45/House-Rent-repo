# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# Note: If no local MongoDB is detected, the server automatically starts an In-Memory MongoDB instance for quick evaluation.
MONGO_URI=mongodb://127.0.0.1:27017/house_rent

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# Admin Registration Protection Key
ADMIN_KEY=HouseRentAdminKey2026
