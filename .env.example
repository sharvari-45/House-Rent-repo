# ===================================================
# House Rent Management System - Environment Template
# ===================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# When left as default or if local MongoDB is not running, the application will
# automatically start an In-Memory MongoDB Server for immediate zero-config demo!
MONGO_URI=mongodb://127.0.0.1:27017/house_rent

# JWT Secret Key for token signing and validation
JWT_SECRET=house_rent_super_secure_jwt_secret_2026_btech_project
JWT_EXPIRES_IN=30d

# Admin Secret Key
ADMIN_KEY=HouseRentAdminKey2026
